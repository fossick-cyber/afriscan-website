{% extends "base.html.j2" %}
{% block main %}
{% include "partials/pagehead.html.j2" %}
{% set f = t.form %}
{% set names = form_country_names() %}
{% set subject = f.subject ~ " · " ~ loc.label %}
<section class="section">
  <div class="container contact-grid">
    <form class="contact-form" id="contactForm" action="{{ site.form.action }}" method="POST" data-ajax="{{ site.form.ajax }}" data-thanks="{{ thanks_url }}" data-sending="{{ f.sending }}" data-error="{{ f.error }}" data-success="{{ f.success }}" data-subject="{{ subject }}">
      <input type="hidden" name="_subject" value="{{ subject }}">
      <input type="hidden" name="_template" value="table">
      <input type="hidden" name="_captcha" value="false">
      <input type="hidden" name="_next" value="{{ thanks_url }}">
      <input type="hidden" name="site_section" value="{{ loc.label }}">
      <input type="hidden" name="country" id="f-country" value="{{ names.get((loc.country or '')|lower, '') }}" data-names='{{ names|tojson }}'>
      <input type="hidden" name="intent" id="f-intent" value="">
      <input type="hidden" name="industry" id="f-industry" value="">
      <input type="hidden" name="service" id="f-service" value="">
      <div class="hp" aria-hidden="true"><label for="f-honey">{{ f.honeypot }}</label><input type="text" name="_honey" id="f-honey" tabindex="-1" autocomplete="off"></div>
      <p class="form-intro">{{ f.intro }}</p>
      <div class="form-grid">
        <div class="field"><label for="f-name">{{ f.name }}</label><input id="f-name" name="name" autocomplete="name" required aria-describedby="f-name-err" data-err-required="{{ f.err_name }}"><p class="field-error" id="f-name-err" hidden></p></div>
        <div class="field"><label for="f-email">{{ f.email }}</label><input id="f-email" name="email" type="email" autocomplete="email" spellcheck="false" autocapitalize="off" required aria-describedby="f-email-err" data-err-required="{{ f.err_email }}" data-err-format="{{ f.err_email_format }}"><p class="field-error" id="f-email-err" hidden></p></div>
        <div class="field"><label for="f-phone">{{ f.phone }} <span class="opt">({{ f.optional }})</span></label><input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel"></div>
        <div class="field"><label for="f-company">{{ f.company }} <span class="opt">({{ f.optional }})</span></label><input id="f-company" name="company" autocomplete="organization"></div>
        <div class="field field--wide"><label for="f-msg">{{ f.message }} <span class="opt">({{ f.optional }})</span></label><textarea id="f-msg" name="message" rows="3" placeholder="{{ f.message_placeholder }}"></textarea></div>
      </div>
      <button type="submit" class="btn btn-lg form-submit">{{ icon('send', 'icon icon-sm') }}<span>{{ f.submit }}</span></button>
      <p class="form-privacy">{{ icon('lock', 'icon icon-xs') }} {{ f.privacy }}{% set pv = resolve('privacy') %}{% if pv and not pv.noindex %} <a href="{{ pv.url }}"{% if pv.lang2 != page.lang2 %} hreflang="{{ pv.lang }}"{% endif %}>{{ f.privacy_link }}</a>{% endif %}</p>
      <p class="form-status" id="formMsg" role="status" aria-live="polite"></p>
    </form>
    <aside class="contact-aside" aria-label="{{ f.next_title }}">
      <div class="aside-block">
        <h2 class="h3">{{ f.next_title }}</h2>
        <ol class="mini-steps">{% for s in f.next_steps %}<li>{{ s }}</li>{% endfor %}</ol>
      </div>
      <div class="aside-block">
        <h2 class="h3">{{ f.send_title }}</h2>
        <p>{{ f.send_text }}</p>
      </div>
      <div class="aside-block">
        <h2 class="h3">{{ f.procurement_title }}</h2>
        <p>{{ f.procurement_text }}</p>
      </div>
      {% if page.body_html|trim %}<div class="aside-block flow">{{ page.body_html }}</div>{% endif %}
    </aside>
  </div>
</section>
{% include "partials/faq.html.j2" %}
{% endblock %}
