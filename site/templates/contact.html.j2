{% extends "base.html.j2" %}
{% block main %}
{% include "partials/pagehead.html.j2" %}
{% set f = t.form %}
<section class="section">
  <div class="container contact-grid">
    <form class="contact-form" id="contactForm" action="{{ site.form.action }}" method="POST" data-ajax="{{ site.form.ajax }}" data-thanks="{{ thanks_url }}" data-sending="{{ f.sending }}" data-error="{{ f.error }}" data-success="{{ f.success }}" data-subject="{{ f.subject }}">
      <input type="hidden" name="_subject" value="{{ f.subject }}">
      <input type="hidden" name="_template" value="table">
      <input type="hidden" name="_captcha" value="false">
      <input type="hidden" name="_next" value="{{ thanks_url }}">
      <input type="hidden" name="intent" id="f-intent" value="">
      <input type="hidden" name="industry" id="f-industry" value="">
      <input type="hidden" name="service" id="f-service" value="">
      <input type="hidden" name="site_section" value="{{ loc.label }}">
      <div class="hp" aria-hidden="true"><label for="f-honey">{{ f.honeypot }}</label><input type="text" name="_honey" id="f-honey" tabindex="-1" autocomplete="off"></div>
      <fieldset>
        <legend>{{ f.legend_you }}</legend>
        <div class="form-grid">
          <div class="field"><label for="f-name">{{ f.name }} <span class="req" aria-hidden="true">*</span></label><input id="f-name" name="name" autocomplete="name" required></div>
          <div class="field"><label for="f-email">{{ f.email }} <span class="req" aria-hidden="true">*</span></label><input id="f-email" name="email" type="email" autocomplete="email" required></div>
          <div class="field"><label for="f-org">{{ f.org }} <span class="req" aria-hidden="true">*</span></label><input id="f-org" name="organisation" autocomplete="organization" required></div>
          <div class="field"><label for="f-role">{{ f.role }} <span class="req" aria-hidden="true">*</span></label>
            <select id="f-role" name="role" required><option value="">{{ f.choose }}</option>{% for o in f.roles %}<option>{{ o }}</option>{% endfor %}</select></div>
        </div>
      </fieldset>
      <fieldset>
        <legend>{{ f.legend_job }}</legend>
        <div class="form-grid">
          <div class="field"><label for="f-country">{{ f.country }} <span class="req" aria-hidden="true">*</span></label>
            <select id="f-country" name="country" required><option value="">{{ f.choose }}</option>{% set here = (loc.country or '')|lower %}{% set fc = form_countries() %}{% for g in fc.groups %}<optgroup label="{{ g.title }}">{% for o in g.options %}<option data-code="{{ o.code }}"{% if o.code == here %} selected{% endif %}>{{ o.name }}</option>{% endfor %}</optgroup>{% endfor %}<option data-code="other">{{ fc.other }}</option></select></div>
          <div class="field"><label for="f-asset">{{ f.asset }} <span class="req" aria-hidden="true">*</span></label>
            <select id="f-asset" name="asset" required><option value="">{{ f.choose }}</option>{% for o in f.assets %}<option>{{ o }}</option>{% endfor %}</select></div>
          <div class="field"><label for="f-size">{{ f.size }}</label><input id="f-size" name="size" inputmode="decimal"></div>
          <div class="field"><label for="f-when">{{ f.when }}</label><input id="f-when" name="deadline"></div>
        </div>
        <div class="field field--checks" role="group" aria-labelledby="f-needs-label">
          <p class="label" id="f-needs-label">{{ f.needs }}</p>
          <div class="checks">
          {% for o in f.needs_options %}<label class="check"><input type="checkbox" name="needs" value="{{ o }}"><span>{{ o }}</span></label>{% endfor %}
          </div>
        </div>
        <div class="field"><label for="f-msg">{{ f.message }}</label><textarea id="f-msg" name="message" rows="5" aria-describedby="f-msg-hint"></textarea><p class="hint" id="f-msg-hint">{{ f.message_hint }}</p></div>
        <div class="field field--half"><label for="f-heard">{{ f.heard }}</label>
          <select id="f-heard" name="heard"><option value="">{{ f.choose }}</option>{% for o in f.heard_options %}<option>{{ o }}</option>{% endfor %}</select></div>
      </fieldset>
      <p class="form-privacy">{{ icon('lock', 'icon icon-xs') }} {{ f.privacy }}{% set pv = resolve('privacy') %}{% if pv and not pv.noindex %} <a href="{{ pv.url }}"{% if pv.lang2 != page.lang2 %} hreflang="{{ pv.lang }}"{% endif %}>{{ f.privacy_link }}</a>{% endif %}</p>
      <button type="submit" class="btn btn-lg">{{ icon('send', 'icon icon-sm') }}<span>{{ f.submit }}</span></button>
      <p class="form-status" id="formMsg" role="status" aria-live="polite"></p>
    </form>
    <aside class="contact-aside" aria-label="{{ f.next_title }}">
      <div class="aside-block">
        <h2 class="h3">{{ f.next_title }}</h2>
        <ol class="mini-steps">{% for s in f.next_steps %}<li>{{ s }}</li>{% endfor %}</ol>
      </div>
      <div class="aside-block">
        <h2 class="h3">{{ f.send_title }}</h2>
        <p>{{ f.send_text }}</p>
      </div>
      <div class="aside-block">
        <h2 class="h3">{{ f.procurement_title }}</h2>
        <p>{{ f.procurement_text }}</p>
      </div>
      {% if page.body_html|trim %}<div class="aside-block flow">{{ page.body_html }}</div>{% endif %}
    </aside>
  </div>
</section>
{% include "partials/faq.html.j2" %}
{% endblock %}
