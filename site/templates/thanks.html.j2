{% extends "base.html.j2" %}
{% block main %}
<section class="page-head">
  <div class="container">
    <p class="eyebrow">{{ icon('check', 'icon icon-sm') }} {{ t.nav.contact }}</p>
    <h1>{{ page.h1 }}</h1>
    <p class="lead">{{ t.thanks.text }}</p>
  </div>
</section>
<section class="section">
  <div class="container">
    <h2>{{ t.thanks.next }}</h2>
    <div class="cards cards--3">
    {% for q in links if q.key != 'contact' %}
      {% set lt = label_text(q) %}<a class="card card--link" href="{{ q.url }}"{% if q.lang2 != page.lang2 %} hreflang="{{ q.lang }}"{% endif %}><h3>{{ t.notfound.home if q.key == 'home' else label_of(q) }}</h3><p>{{ q.description if q.lang2 == page.lang2 else lt[1] }}</p><span class="card-more">{{ t.labels.open }} {{ icon('arrow-right', 'icon icon-xs') }}</span></a>
    {% endfor %}
    </div>
  </div>
</section>
{% endblock %}
