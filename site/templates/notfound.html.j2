{% extends "base.html.j2" %}
{% block main %}
<section class="page-head">
  <div class="container">
    <p class="eyebrow">404</p>
    <h1>{{ page.h1 }}</h1>
    <p class="lead">{{ t.notfound.text }}</p>
  </div>
</section>
<section class="section">
  <div class="container">
    <div class="cards cards--3">
    {% for q in links %}
      <a class="card card--link" href="{{ q.url }}"><h2 class="h3">{{ label_of(q) }}</h2><p>{{ q.description }}</p><span class="card-more">{{ t.labels.open }} {{ icon('arrow-right', 'icon icon-xs') }}</span></a>
    {% endfor %}
    </div>
  </div>
</section>
{% endblock %}
