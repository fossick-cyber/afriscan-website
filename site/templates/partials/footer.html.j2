<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="logo" href="{{ (build.home_of(page.loc_key) or {'url': '/'}).url }}"><span class="logo-word">Afri<span>Scan</span></span><small>{{ t.brand_by }}</small></a>
      <p>{{ t.footer.tagline }}</p>
      <p class="footer-note">{{ icon('user-check', 'icon icon-sm') }}<span>{{ t.footer.review }}</span></p>
      <p class="footer-note">{{ icon('drone', 'icon icon-sm') }}<span>{{ t.footer.drones }}</span></p>
    </div>
    <nav class="footer-nav" aria-label="{{ t.labels.footer_nav }}">
      {% if footer.explore %}
      <div><p class="footer-title">{{ t.footer.explore }}</p><ul>{% for i in footer.explore %}<li><a href="{{ i.href }}"{% if i.lang %} hreflang="{{ i.lang }}"{% endif %}>{{ i.label }}{% if i.badge %} <span class="lang-badge">{{ i.badge }}</span>{% endif %}</a></li>{% endfor %}</ul></div>
      {% endif %}
      {% if footer.industries %}
      <div><p class="footer-title">{{ t.footer.industries }}</p><ul>{% for i in footer.industries %}<li><a href="{{ i.href }}"{% if i.lang %} hreflang="{{ i.lang }}"{% endif %}>{{ i.label }}{% if i.badge %} <span class="lang-badge">{{ i.badge }}</span>{% endif %}</a></li>{% endfor %}</ul></div>
      {% endif %}
      {% if footer.solutions %}
      <div><p class="footer-title">{{ t.footer.solutions }}</p><ul>{% for i in footer.solutions %}<li><a href="{{ i.href }}"{% if i.lang %} hreflang="{{ i.lang }}"{% endif %}>{{ i.label }}{% if i.badge %} <span class="lang-badge">{{ i.badge }}</span>{% endif %}</a></li>{% endfor %}</ul></div>
      {% endif %}
      {% if footer.how or footer.resources %}
      <div><p class="footer-title">{{ t.footer.how }}</p><ul>{% for i in footer.how + footer.resources %}<li><a href="{{ i.href }}"{% if i.lang %} hreflang="{{ i.lang }}"{% endif %}>{{ i.label }}{% if i.badge %} <span class="lang-badge">{{ i.badge }}</span>{% endif %}</a></li>{% endfor %}</ul></div>
      {% endif %}
      <div>
        <p class="footer-title">{{ t.footer.company }}</p>
        <ul>
          <li><a href="{{ contact(page) }}">{{ t.footer.contact }}</a></li>
          <li><a href="{{ site.parent.url }}">{{ t.footer.afridrone }}</a></li>
          {% for k in ['about', 'privacy'] %}{% set cp = resolve(k) %}{% if cp and not cp.noindex %}<li><a href="{{ cp.url }}"{% if cp.lang2 != page.lang2 %} hreflang="{{ cp.lang }}" lang="{{ cp.lang }}"{% endif %}>{{ label_of(cp) }}</a></li>{% endif %}{% endfor %}
        </ul>
      </div>
      {% if footer.countries|length > 1 %}
      <div class="footer-countries">
        <p class="footer-title">{{ t.footer.countries }}</p>
        {% if footer.countries_top %}<ul class="footer-country-top">{% for c in footer.countries_top %}<li><a href="{{ c.href }}" hreflang="{{ c.lang }}" lang="{{ c.lang }}">{{ c.label }}</a></li>{% endfor %}</ul>{% endif %}
        <div class="footer-country-grid">
        {% for g in footer.country_regions %}
          <div><p class="footer-sub">{{ g.title }}</p>
          <ul>{% for c in g['items'] %}<li><a href="{{ c.href }}" hreflang="{{ c.lang }}" lang="{{ c.lang }}">{{ c.label }}{% if c.draft %} <span class="lang-badge">Draft</span>{% endif %}</a></li>{% endfor %}</ul></div>
        {% endfor %}
        </div>
      </div>
      {% endif %}
    </nav>
  </div>
  <div class="container footer-credits">
    <p class="footer-title">{{ t.footer.credits_title }}</p>
    <p>{{ t.footer.credits }}{% set ds = resolve('data-sources') %}{% if ds and not ds.noindex %} <a href="{{ ds.url }}"{% if ds.lang2 != page.lang2 %} hreflang="{{ ds.lang }}"{% endif %}>{{ t.footer.credits_link }}</a>{% endif %}</p>
  </div>
  <div class="container footer-bottom">
    <p>© {{ site.copyright_year }} AfriScan by <a href="{{ site.parent.url }}">Afridrone</a>. {{ t.footer.rights }}</p>
  </div>
</footer>
