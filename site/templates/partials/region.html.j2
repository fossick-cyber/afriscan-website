{% macro region_link(r) %}<li><a href="{{ r.href }}" hreflang="{{ r.lang }}"{% if r.get('text_lang') %} lang="{{ r.text_lang }}"{% endif %} data-region="{{ r.key }}"{% if r.current %} aria-current="page"{% endif %}>{{ r.label }}{% if r.draft %} <span class="lang-badge">Draft</span>{% endif %}</a></li>{% endmacro %}
{% set menu = page.region_menu %}
<details class="region">
  <summary><span class="sr-only">{{ t.region.choose }}: </span>{{ icon('globe', 'icon icon-sm') }}<span class="region-current">{{ loc.short }}</span>{{ icon('chevron-down', 'icon icon-xs') }}</summary>
  <div class="region-menu region-menu--g{{ menu.groups|length }}">
    <p class="region-title">{{ t.region.choose }}</p>
    {% if menu.top %}
    <ul class="region-top">
    {% for r in menu.top %}
      {{ region_link(r) }}
    {% endfor %}
    </ul>
    {% endif %}
    <div class="region-groups">
    {% for g in menu.groups %}
      <div class="region-group">
        <p class="region-group-title" id="region-{{ g.key }}">{{ g.title }}</p>
        <ul aria-labelledby="region-{{ g.key }}">
        {% for r in g['items'] %}
          {{ region_link(r) }}
        {% endfor %}
        </ul>
      </div>
    {% endfor %}
    </div>
  </div>
</details>
