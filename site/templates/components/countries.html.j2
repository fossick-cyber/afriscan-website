{% if groups %}
<div class="countries-directory">
{% for g in groups %}
  <div class="country-region">
    <h3 class="country-region-title">{{ g.title }}</h3>
    <div class="cards cards--{{ cols }}">
    {% for c in g['items'] %}
      {% if c.links %}
      <div class="card country-card">
        <p class="card-eyebrow">{{ c.langs }}</p>
        <h4><a href="{{ c.href }}" hreflang="{{ c.lang }}">{{ c.title }}</a>{% if c.draft %} <span class="lang-badge">Draft</span>{% endif %}</h4>
        <p>{{ c.text }}</p>
        <p class="country-card-links">{% for l in c.links %}<a href="{{ l.href }}" hreflang="{{ l.lang }}" lang="{{ l.lang }}">{{ l.label }} {{ icon('arrow-right', 'icon icon-xs') }}</a>{% endfor %}</p>
      </div>
      {% else %}
      <a class="card card--link country-card" href="{{ c.href }}" hreflang="{{ c.lang }}">
        <p class="card-eyebrow">{{ c.langs }}</p>
        <h4>{{ c.title }}{% if c.draft %} <span class="lang-badge">Draft</span>{% endif %}</h4>
        <p>{{ c.text }}</p>
        <span class="card-more">{{ t.labels.open }} {{ icon('arrow-right', 'icon icon-xs') }}</span>
      </a>
      {% endif %}
    {% endfor %}
    </div>
  </div>
{% endfor %}
</div>
{% endif %}
{{ inner }}
